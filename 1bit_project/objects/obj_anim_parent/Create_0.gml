/// @description
tposx=0;
tposy=0;
tscalex=image_xscale;
tscaley=image_yscale;
sprite_back=spr_hero_back;
sprite_light=spr_fx_light;
sprite_shadow=spr_shadow;
char_rot=image_angle;
once=true;

//tweakable variables
start_frame=0
end_frame=100
dir=1;
skin_color=c_white;
sprite_body=spr_body_naked;
sprite_head=choose(spr_head_female,spr_head_female1,spr_head_female2);
loop=true;

//keep at the end
image_index=start_frame;
image_speed=0.5;